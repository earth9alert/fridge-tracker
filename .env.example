# Supabase Configuration (Optional)
# เปิดใช้ cloud database แทน LocalStorage
# 1. สร้าง project ที่ https://supabase.com
# 2. สร้าง table "fridge_items" ตามโครงสร้าง SQL ด้านล่าง
# 3. Copy credentials และ paste ที่นี่

VITE_USE_SUPABASE=false
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# หากต้องการใช้ Supabase ให้:
# 1. ตั้ง VITE_USE_SUPABASE=true
# 2. ใส่ URL และ KEY จาก Supabase

